{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract A - Frame Detections",
  "description": "Contrato A: Registro de deteccoes brutas de agentes por quadro para desacoplamento de percepcao",
  "type": "object",
  "required": ["video_id", "frame_id", "timestamp_s", "detections"],
  "properties": {
    "video_id": {
      "type": "string",
      "description": "Identificador unico do video ou sessao"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Indice do quadro monotono no video"
    },
    "timestamp_s": {
      "type": "number",
      "minimum": 0.0,
      "description": "Instante temporal do quadro em segundos"
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bbox_xyxy", "class_name", "class_id", "confidence"],
        "properties": {
          "bbox_xyxy": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "Coordenadas da caixa [x1, y1, x2, y2]"
          },
          "class_name": {
            "type": "string",
            "enum": ["person", "car", "motorcycle", "bus", "truck"]
          },
          "class_id": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    }
  }
}
